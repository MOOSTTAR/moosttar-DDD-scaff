<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.moosttar</groupId>
    <artifactId>moosttar-ddd-scaff</artifactId>
    <version>1.1</version>
    <packaging>maven-archetype</packaging>

    <name>moosttar-ddd-scaff</name>
    <description>DDD 多模块脚手架（DDD Scaffold Archetype）— 基于 Spring Boot 2.7，内置 api/app/domain/trigger/infrastructure/types 六模块分层</description>
    <url>https://github.com/MOOSTTAR/moosttar-DDD-scaff</url>

    <licenses>
        <license>
            <name>The Apache Software License, Version 2.0</name>
            <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>moosttar</id>
            <name>moosttar</name>
            <email>moosttar@qq.com</email>
            <organization>MOOSTTAR</organization>
            <organizationUrl>https://github.com/MOOSTTAR</organizationUrl>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/MOOSTTAR/moosttar-DDD-scaff.git</connection>
        <developerConnection>scm:git:git@github.com:MOOSTTAR/moosttar-DDD-scaff.git</developerConnection>
        <url>https://github.com/MOOSTTAR/moosttar-DDD-scaff</url>
        <tag>v1.1</tag>
    </scm>

    <properties>
        <!-- gpg.skip=true 时跳过 GPG 签名（本地快速构建用）；CI 发布时传 -Dgpg.skip=false 并设置 GPG_PASSPHRASE -->
        <gpg.skip>false</gpg.skip>
    </properties>

    <build>
        <extensions>
            <extension>
                <groupId>org.apache.maven.archetype</groupId>
                <artifactId>archetype-packaging</artifactId>
                <version>3.2.1</version>
            </extension>
        </extensions>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-archetype-plugin</artifactId>
                <version>3.2.1</version>
                <extensions>true</extensions>
                <configuration>
                    <!-- JarMojo 默认排除 .gitignore 等隐藏文件，脚手架模板需要生成 .gitignore，故关闭默认排除 -->
                    <useDefaultExcludes>false</useDefaultExcludes>
                </configuration>
            </plugin>
            <!-- 以下满足 Maven Central 发布规则：GPG 签名 + sources jar + javadoc jar。
                 archetype 的 packaging 非 Java classpath-capable，maven-javadoc-plugin 会直接跳过
                 （"Not executing Javadoc..."），故 javadoc jar 用 maven-jar-plugin 生成空占位包。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <executions>
                    <execution>
                        <id>empty-javadoc-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <!-- 打一个空的 -javadoc.jar（仅含 src/main/javadoc 下的占位说明）以通过 Central 校验 -->
                            <classifier>javadoc</classifier>
                            <classesDirectory>${project.basedir}/src/main/javadoc</classesDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-gpg-plugin</artifactId>
                <version>3.2.4</version>
                <configuration>
                    <!-- CI 发布时从环境变量 GPG_PASSPHRASE 读密钥口令；本地快速构建用 -Dgpg.skip=true 跳过 -->
                    <skip>${gpg.skip}</skip>
                    <passphrase>${env.GPG_PASSPHRASE}</passphrase>
                </configuration>
                <executions>
                    <execution>
                        <id>sign-artifacts</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>sign</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- 发布到 Maven Central（Central Portal）的官方插件，接管 deploy 阶段：
                 extensions=true 使其替换 maven-deploy-plugin，上传 bundle 后自动发布。
                 认证走 settings.xml 的 server id=central（User Token）。 -->
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <version>0.11.0</version>
                <extensions>true</extensions>
                <configuration>
                    <publishingServerId>central</publishingServerId>
                    <!-- 上传并通过校验后自动对外发布，无需在 Portal 手动点 Publish -->
                    <autoPublish>true</autoPublish>
                    <!-- 构建等到发布完成（同步到 Maven Central）后才返回 -->
                    <waitUntil>published</waitUntil>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <distributionManagement>
        <!-- 发布到 Maven Central 使用 Sonatype central-publishing-maven-plugin（见 build.plugins），
            它在 deploy 阶段上传 bundle 到 Central Portal 并自动发布，无需手动操作。 -->
    </distributionManagement>
</project>
